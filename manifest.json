{
  "name": "Anubis Bypass",
  "version": "2.0.4",
  "description": "Bypasses Anubis DDoS protection.",
  "manifest_version": 3,
  "permissions": ["declarativeNetRequestWithHostAccess", "webRequest", "webRequestBlocking"],
  "host_permissions": ["*://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "anubis-bypass@andre4ik3.dev",
      "update_url": "https://webextensions.andre4ik3.dev/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "incognito": "split",
  "update_url": "https://webextensions.andre4ik3.dev/updates.xml",
  "web_accessible_resources": [
    {
      "matches": ["*://*/*"],
      "resources": ["/blocked.html"]
    }
  ]
}
