{
  "name": "Anubis Bypass",
  "version": "2.0.0",
  "description": "Bypasses Anubis DDoS protection.",
  "manifest_version": 3,
  "permissions": ["declarativeNetRequestWithHostAccess", "webRequest"],
  "host_permissions": ["*://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "anubis-bypass@andre4ik3.dev"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  }
}
